{
  "name": "draftdex-qa-framework",
  "version": "0.2.0",
  "private": true,
  "description": "Playwright + TypeScript test framework for DraftDex: a typed prerequisite engine, flows with a machine-readable catalog, zod contracts, and UI + API end-to-end tests.",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:internal": "playwright test --project=internal",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report reports/html",
    "catalog": "tsx src/cli/catalog.ts",
    "plan": "tsx src/cli/plan.ts",
    "lint": "tsc --noEmit",
    "browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
