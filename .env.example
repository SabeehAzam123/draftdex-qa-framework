# Copy to .env. Only values that are secret or differ per machine go here; everything else is in config/.
# Only src/config reads these (a self-test enforces it).

# Which config/environments/<name>.yaml to use (default: local)
TEST_ENV=local

# The admin account, for admin flows. The app's local demo data creates this one
# (see DraftDex's README); use your own on a shared copy.
DRAFTDEX_ADMIN_EMAIL=admin@draftdex.test
DRAFTDEX_ADMIN_PASSWORD=Admin123!

# Optional: the DraftDex app's folder. When set, a run starts the app itself if it isn't up yet.
# DRAFTDEX_APP_DIR=../draftdex
